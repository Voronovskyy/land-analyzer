<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<VBox spacing="0"
      stylesheets="@../css/styles.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ua.edu.university.ui.MainController">

    <!-- ══ Header ══════════════════════════════════════════════ -->
    <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="10">

        <!-- Ліва частина: назва + підзаголовок -->
        <VBox spacing="3">
            <Label text="АНАЛІЗ ЗЕМЕЛЬНИХ ДІЛЯНОК" styleClass="app-title"/>
            <Label text="Інтелектуальна система геоаналізу · DOM.RIA · Open-Meteo · Overpass"
                   styleClass="app-subtitle"/>
        </VBox>

        <!-- Розтягувач -->
        <Region HBox.hgrow="ALWAYS"/>

        <!-- Права частина: бейдж -->
        <Label text="PhD RESEARCH" styleClass="app-badge"/>
    </HBox>

    <!-- ══ Toolbar ══════════════════════════════════════════════ -->
    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="8">

        <TextField fx:id="addressInputField"
                   promptText="Адреса, кадастровий номер або координати (49.84,24.02; 49.85,24.03)..."
                   styleClass="search-field"
                   HBox.hgrow="ALWAYS"/>

        <Button fx:id="searchButton"
                text="Пошук"
                onAction="#handleSearch"
                styleClass="action-btn, btn-search"/>

        <!-- Тонкий роздільник -->
        <Region styleClass="btn-separator"/>

        <Button fx:id="visualizeButton"
                text="3D Модель"
                onAction="#handleShowVisualization"
                styleClass="action-btn, btn-3d"/>

        <Button fx:id="reportButton"
                text="Звіт PDF"
                onAction="#handleGenerateReport"
                styleClass="action-btn, btn-report"/>

    </HBox>

    <!-- ══ Status Bar ═══════════════════════════════════════════ -->
    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="6">
        <Label text="●" styleClass="status-dot"/>
        <Label fx:id="resultLabel"
               text="Введіть дані для початку аналізу"
               styleClass="status-label"/>
    </HBox>

    <!-- ══ Map ══════════════════════════════════════════════════ -->
    <WebView fx:id="mapWebView" VBox.vgrow="ALWAYS"/>

</VBox>
