<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ua.edu.university.ui.MainController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Аналіз земельних ділянок" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="addressInputField" promptText="Адреса або кадастровий номер..." HBox.hgrow="ALWAYS" />
        <Button fx:id="searchButton" text="Пошук" onAction="#handleSearch"
                style="-fx-base: #2ecc71; -fx-text-fill: white; -fx-cursor: hand;"/>

        <Button fx:id="visualizeButton" text="3D Модель" onAction="#handleShowVisualization"
                style="-fx-base: #f39c12; -fx-text-fill: white; -fx-cursor: hand;"/>

        <Button fx:id="reportButton" text="Звіт (PDF)" onAction="#handleGenerateReport"
                style="-fx-base: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>

    <Label fx:id="resultLabel" text="Введіть дані для початку аналізу" textFill="#7f8c8d">
        <font>
            <Font size="14.0"/>
        </font>
    </Label>

    <WebView fx:id="mapWebView" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="15.0"/>
        </VBox.margin>
    </WebView>
</VBox>